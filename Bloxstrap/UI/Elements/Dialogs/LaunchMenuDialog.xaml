<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.LaunchMenuDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    xmlns:app="clr-namespace:Bloxstrap"
    Title="{x:Static app:App.ProjectName}" Width="760" MinWidth="620"
    SizeToContent="Height" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
    ResizeMode="NoResize" Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Padding="12,8" ShowMinimize="False" ShowMaximize="False"
            Title="{x:Static app:App.ProjectName}" Icon="pack://application:,,,/Angestrap.ico"
            CanMaximize="False" KeyboardNavigation.TabNavigation="None" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,16,28,24">
                <Border Style="{StaticResource AngestrapSurface}" Padding="24"
                    Background="{DynamicResource AngestrapAccentTintBrush}" BorderBrush="{DynamicResource AngestrapAccentBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Width="88" Height="88" Source="pack://application:,,,/Angestrap.png"
                            RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,24,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static app:App.ProjectName}" Style="{StaticResource AngestrapPageTitle}" />
                            <TextBlock Text="Ton espace Roblox, prêt à jouer." Style="{StaticResource AngestrapBody}" Margin="0,6,0,10" />
                            <TextBlock Text="{Binding Version, Mode=OneTime}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Jouer" Style="{StaticResource AngestrapSectionTitle}" Margin="0,0,0,12" />
                        <ui:Button Appearance="Primary" Icon="ArrowRight24" Padding="20,16"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}"
                            Command="{Binding LaunchRobloxCommand, Mode=OneTime}" AutomationProperties.Name="Lancer Roblox" />
                        <ui:CardAction Margin="0,12,0,0" Icon="Globe24" Padding="18" Click="ServerOptimizer_Click">
                            <StackPanel>
                                <TextBlock Text="Serveur à faible ping" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Compare les serveurs avant de rejoindre." Style="{StaticResource AngestrapBody}" Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:CardAction>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Personnaliser" Style="{StaticResource AngestrapSectionTitle}" Margin="0,0,0,12" />
                        <ui:CardAction Icon="Settings28" Padding="18" Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
                            <StackPanel>
                                <TextBlock Text="{x:Static resources:Strings.LaunchMenu_ConfigureSettings}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Graphismes, apparence et intégrations." Style="{StaticResource AngestrapBody}" Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:CardAction>
                        <ui:CardAction Margin="0,12,0,0" Icon="Wrench24" Padding="18" Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}">
                            <TextBlock Text="{x:Static resources:Strings.LaunchMenu_LaunchRobloxStudio}" FontSize="14" FontWeight="SemiBold" />
                        </ui:CardAction>
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                    <WrapPanel HorizontalAlignment="Center">
                        <ui:Hyperlink Content="{x:Static resources:Strings.About_Title}" Click="AboutLink_Click" Margin="8,0" />
                        <ui:Hyperlink Content="{x:Static resources:Strings.LaunchMenu_BloxstrapWiki}" NavigateUri="https://github.com/xadv404/wb9blox/wiki" Margin="8,0" />
                        <ui:Hyperlink Content="{x:Static resources:Strings.LaunchMenu_RobloxCommunity}" NavigateUri="https://www.roblox.com/communities/32380007/Bloxstrap" Margin="8,0" />
                        <ui:Hyperlink Content="{x:Static resources:Strings.Common_Help}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://bloxstraplabs.com/wiki/help/" Margin="8,0" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</base:WpfUiWindow>

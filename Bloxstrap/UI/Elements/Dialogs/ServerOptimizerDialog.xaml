<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.ServerOptimizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    Title="Serveur à faible ping" Width="520" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="Trouver un serveur à faible ping" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,8" Text="Colle le lien du jeu Roblox ou son identifiant de lieu." TextWrapping="Wrap" />
        <TextBox x:Name="PlaceInput" />
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
            Text="Compare jusqu’à 300 serveurs publics ayant des places libres. Le ping annoncé par Roblox peut différer de celui de ta connexion. Les serveurs privés ne sont pas concernés." />
        <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SearchButton" Content="Rechercher" Click="Search_Click" Padding="16,8" />
            <Button x:Name="JoinButton" Content="Rejoindre" Click="Join_Click" IsEnabled="False" Margin="8,0,0,0" Padding="16,8" />
        </StackPanel>
    </StackPanel>
</base:WpfUiWindow>
